<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_meta_capi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.meta.capi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Meta CAPI" data-string="Meta CAPI"
                     data-key="fayna_meta_capi" groups="base.group_system">
                    <block title="Meta Conversions API" name="meta_capi_config">
                        <setting string="Enable Meta CAPI"
                                 help="Server-side conversion tracking (survives ad blockers, iOS 14.5+).">
                            <field name="fayna_capi_enabled"/>
                        </setting>
                        <setting string="Pixel ID">
                            <field name="fayna_capi_pixel_id"
                                   placeholder="123456789012345"/>
                        </setting>
                        <setting string="Access Token"
                                 help="From Meta Events Manager → Settings → Conversions API.">
                            <field name="fayna_capi_access_token" password="True"
                                   placeholder="EAAxxxxxx"/>
                        </setting>
                        <setting string="API Version">
                            <field name="fayna_capi_api_version"
                                   placeholder="v19.0"/>
                        </setting>
                        <setting string="Test Event Code"
                                 help="From Meta Events Manager Test Events tab. Leave empty on production.">
                            <field name="fayna_capi_test_event_code"
                                   placeholder="TEST12345"/>
                        </setting>
                    </block>
                    <block title="Diagnostics" name="meta_capi_test">
                        <setting string="Send test ViewContent event"
                                 help="Sends a test event. Check Meta Events Manager Test Events tab (may take 60 s).">
                            <button name="action_send_test_capi_event" type="object"
                                    string="Send test event" class="btn btn-secondary"
                                    groups="base.group_system"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
