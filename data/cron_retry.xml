<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
          Retry cron: every 30 minutes, attempts to re-send failed CAPI events
          up to 3 times.  noupdate=1 keeps admin customisation after upgrade.
        -->
        <record id="cron_retry_failed_capi_events" model="ir.cron">
            <field name="name">Meta CAPI — Retry failed events</field>
            <field name="model_id" ref="model_fayna_capi_event_log"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_failed_events()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
